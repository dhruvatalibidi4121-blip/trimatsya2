# TRI-MATSYA FastAPI backend
APP_ENV=development
DATABASE_URL=postgresql+psycopg://trimatsya:trimatsya@localhost:5432/trimatsya
# For quick local run without PostgreSQL you can use:
# DATABASE_URL=sqlite:///./data/trimatsya.db
SECRET_KEY=change-this-to-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=43200
OTP_PROVIDER=console

# WhatsApp Business Cloud API (optional)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_CONTACT_NUMBER=

# n8n automation (optional)
N8N_WEBHOOK_URL=
# Shared secret for n8n -> TRI-MATSYA webhook calls (send as X-N8N-Webhook-Secret header)
N8N_WEBHOOK_SECRET=

# Frontend/static
CORS_ORIGINS=http://localhost:3000,http://localhost:8000
